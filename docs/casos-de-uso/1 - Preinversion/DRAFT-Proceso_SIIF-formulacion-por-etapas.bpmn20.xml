        <omgdc:Bounds x="560" y="350" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="UT_Diseno" id="Shape_UT_Diseno">
        <omgdc:Bounds x="120" y="460" width="140" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="UT_RevisionOTDiseno" id="Shape_UT_RevisionOTDiseno">
        <omgdc:Bounds x="300" y="460" width="140" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="gw_ot_diseno" id="Shape_gw_ot_diseno">
        <omgdc:Bounds x="480" y="470" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape bpmnElement="end_draft" id="Shape_end_draft">
        <omgdc:Bounds x="660" y="470" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Edges (grilla simple, para reordenar en Flowable Modeler) -->
