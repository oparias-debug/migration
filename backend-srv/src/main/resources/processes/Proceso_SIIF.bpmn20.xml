<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://siip.com/bpmn/proceso-proyecto">

  <process id="proceso_ciclo_vida_proyecto_siip" name="Ciclo de Vida del Proyecto SIIP" isExecutable="true">

    <startEvent id="start1" name="Nuevo Proyecto"/>

    <!-- ===================== REGISTRO Y SOLICITUD DE CUP ===================== -->

    <userTask id="UT_EnElaboracion" name="Registro de Proyecto y Solicitud de CUP (CU-PRE-01)" flowable:candidateGroups="Técnico URP"/>

    <sequenceFlow id="sf_start_a_elaboracion" sourceRef="start1" targetRef="UT_EnElaboracion"/>

    <sequenceFlow id="sf1_solicitar_cup" name="Solicitar CUP" sourceRef="UT_EnElaboracion" targetRef="UT_RevisionCUP">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
    </sequenceFlow>

    <userTask id="UT_RevisionCUP" name="Revisión y Emisión de CUP / Opinión Técnica (CU-PRE-01.5 / CU-PRE-26)" flowable:candidateGroups="Técnico PRE"/>

    <sequenceFlow id="sf_revisioncup_a_gw1" sourceRef="UT_RevisionCUP" targetRef="gw1"/>

    <exclusiveGateway id="gw1" name="¿Resultado de la revisión de CUP?"/>

    <sequenceFlow id="sf2_devolver" name="Devolver" sourceRef="gw1" targetRef="UT_ObservadoDGICP">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${decisionRevisionCUP == 'devolver'}</conditionExpression>
    </sequenceFlow>

    <userTask id="UT_ObservadoDGICP" name="Atención de Observaciones DGICP (Registro) (CU-PRE-01)" flowable:candidateGroups="Técnico URP"/>

    <sequenceFlow id="sf3_reenvio_cup" name="Solicitar CUP nuevamente / Enviar respuesta" sourceRef="UT_ObservadoDGICP" targetRef="UT_RevisionCUP">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="sf4_emitir_cup" name="Emitir CUP" sourceRef="gw1" targetRef="UT_CUPAsignado">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${decisionRevisionCUP == 'emitir'}</conditionExpression>
    </sequenceFlow>

    <!-- ===================== CUP ASIGNADO / FORMULACIÓN Y EVALUACIÓN ===================== -->

    <userTask id="UT_CUPAsignado" name="Proyecto con CUP Asignado (CU-PRE-03)" flowable:candidateGroups="Técnico URP"/>

    <sequenceFlow id="sf5_iniciar_identificacion" name="Iniciar Identificación (CU-PRE-04)" sourceRef="UT_CUPAsignado" targetRef="UT_FormulacionEvaluacion">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
    </sequenceFlow>

    <userTask id="UT_FormulacionEvaluacion" name="Formulación y Evaluación del Proyecto (CU-PRE-04 a CU-PRE-23)" flowable:candidateGroups="Técnico URP"/>

    <sequenceFlow id="sf6_finalizar_indicadores" name="Finalizar Indicadores del Proyecto (CU-PRE-23)" sourceRef="UT_FormulacionEvaluacion" targetRef="UT_ProyectoFormulado">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
    </sequenceFlow>

    <userTask id="UT_ProyectoFormulado" name="Proyecto Formulado — Pendiente de Solicitar Viabilidad" flowable:candidateGroups="Técnico URP"/>

    <!-- Conflicto C5: no hay botón/pantalla documentado para esta acción -->
    <sequenceFlow id="sf7_solicitar_viabilidad" name="Solicitar Viabilidad (condición no documentada — ver Conflicto C5)" sourceRef="UT_ProyectoFormulado" targetRef="UT_RevisionViabilidad">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
    </sequenceFlow>

    <!-- ===================== VIABILIDAD ===================== -->

    <userTask id="UT_RevisionViabilidad" name="Revisión de Viabilidad (CU-PRE-24)" flowable:candidateGroups="Viabilizador"/>

    <sequenceFlow id="sf_viabilidad_a_gw2" sourceRef="UT_RevisionViabilidad" targetRef="gw2"/>

    <exclusiveGateway id="gw2" name="¿Resultado de la Viabilidad?"/>

    <sequenceFlow id="sf8_observar_viabilidad" name="Enviar Comentarios" sourceRef="gw2" targetRef="UT_ObservadoViabilidad">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${decisionViabilidad == 'observado'}</conditionExpression>
    </sequenceFlow>

    <userTask id="UT_ObservadoViabilidad" name="Atención de Observaciones de Viabilidad (CU-PRE-24, FA01)" flowable:candidateGroups="Técnico URP"/>

    <sequenceFlow id="sf9_reiniciar_viabilidad" name="Reiniciar Solicitud de Viabilidad" sourceRef="UT_ObservadoViabilidad" targetRef="UT_RevisionViabilidad">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="sf10_emitir_viabilidad" name="Emitir Viabilidad" sourceRef="gw2" targetRef="gw2b">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${decisionViabilidad == 'viable'}</conditionExpression>
    </sequenceFlow>

    <!-- ===================== ELEGIBILIDAD ===================== -->
    <!-- Conflicto C2: "En elegibilidad" no tiene entrada/salida independiente en CU-PRE-25; se fusiona con "Proyecto viable" -->

    <exclusiveGateway id="gw2b" name="¿El proyecto ya cuenta con Elegibilidad? (CU-PRE-24, FA02)"/>

    <sequenceFlow id="sf11_a_elegibilidad" name="No cuenta con Elegibilidad — Ir a Elegibilidad" sourceRef="gw2b" targetRef="UT_Elegibilidad">
      <conditionExpression xsi:type="tFormalExpression">${teniaElegibilidad == false}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sf12_directo_a_ot" name="Ya cuenta con Elegibilidad — Ir a OT" sourceRef="gw2b" targetRef="UT_RevisionOT">
      <conditionExpression xsi:type="tFormalExpression">${teniaElegibilidad == true}</conditionExpression>
    </sequenceFlow>

    <userTask id="UT_Elegibilidad" name="Gestión de Elegibilidad del Proyecto (CU-PRE-25)" flowable:candidateGroups="Viabilizador"/>

    <sequenceFlow id="sf13_emitir_elegibilidad" name="Emitir Elegibilidad" sourceRef="UT_Elegibilidad" targetRef="UT_RevisionOT">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
    </sequenceFlow>

    <!-- ===================== OPINIÓN TÉCNICA ===================== -->

    <userTask id="UT_RevisionOT" name="Revisión de Opinión Técnica (CU-PRE-26)" flowable:candidateGroups="Técnico PRE"/>

    <sequenceFlow id="sf_ot_a_gw3" sourceRef="UT_RevisionOT" targetRef="gw3"/>

    <exclusiveGateway id="gw3" name="¿Resultado de la Opinión Técnica?"/>

    <sequenceFlow id="sf14_observar_ot" name="Enviar Comentarios (OT)" sourceRef="gw3" targetRef="UT_ObservadoOT">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${decisionOT == 'observado'}</conditionExpression>
    </sequenceFlow>

    <userTask id="UT_ObservadoOT" name="Atención de Observaciones de Opinión Técnica (CU-PRE-26, FA03)" flowable:candidateGroups="Técnico URP"/>

    <sequenceFlow id="sf15_reenviar_ot" name="Reenviar tras Ajustes (Viabilidad/Elegibilidad)" sourceRef="UT_ObservadoOT" targetRef="UT_RevisionOT">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
    </sequenceFlow>

    <sequenceFlow id="sf16_ot_favorable" name="OT Favorable" sourceRef="gw3" targetRef="UT_PostOT">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${decisionOT == 'favorable'}</conditionExpression>
    </sequenceFlow>

    <!-- ===================== PROYECTO CON O.T. / PRIORIZACIÓN ===================== -->

    <userTask id="UT_PostOT" name="Priorización y Gestión Post-OT (CU-PRE-26.5)" flowable:candidateGroups="Coordinador PRE"/>

    <sequenceFlow id="sf_postot_a_gw4" sourceRef="UT_PostOT" targetRef="gw4"/>

    <exclusiveGateway id="gw4" name="¿Siguiente paso del proyecto con O.T.?"/>

    <sequenceFlow id="sf17_actualizar_ot" name="Solicitar OT para otra etapa / Actualización" sourceRef="gw4" targetRef="UT_FormulacionEvaluacion">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${decisionPostOT == 'actualizarOT'}</conditionExpression>
    </sequenceFlow>

    <!-- Conflicto C7: brecha no confirmada del ciclo de vida. Sin executionListener a propósito: no hay CU que respalde esta transición como cambio real de "Estado del Proyecto". -->
    <sequenceFlow id="sf18_avanzar_ejecucion" name="Avanzar a Ejecución (transición NO confirmada — ver Conflicto C7)" sourceRef="gw4" targetRef="UT_CierreFinanciero">
      <conditionExpression xsi:type="tFormalExpression">${decisionPostOT == 'avanzarEjecucion'}</conditionExpression>
    </sequenceFlow>

    <!-- ===================== CIERRE FÍSICO Y FINANCIERO ===================== -->

    <userTask id="UT_CierreFinanciero" name="Registro de Cierre Físico y Financiero (CU-EJE-07, SF2.6 / SF-3 Cierre por Excepción)" flowable:candidateGroups="Técnico URP"/>

    <sequenceFlow id="sf_cierre_a_revisionsymp" sourceRef="UT_CierreFinanciero" targetRef="UT_RevisionSYMP"/>

    <userTask id="UT_RevisionSYMP" name="Revisión de Cierre Financiero (CU-EJE-07)" flowable:candidateGroups="Técnico SYMP"/>

    <sequenceFlow id="sf_revisionsymp_a_gw5" sourceRef="UT_RevisionSYMP" targetRef="gw5"/>

    <exclusiveGateway id="gw5" name="¿Resultado de la revisión de Cierre?"/>

    <!-- Ciclo interno de revisión Técnico SYMP <-> Técnico URP: no cambia el "Estado del Proyecto" del catálogo RN04, por lo que no lleva executionListener -->
    <sequenceFlow id="sf19_observado_cierre" name="Observado (revisión interna, no es transición de estado del catálogo)" sourceRef="gw5" targetRef="UT_CierreFinanciero">
      <conditionExpression xsi:type="tFormalExpression">${decisionCierreSYMP == 'observado'}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sf20_cierre_definitivo" name="Cierre Definitivo" sourceRef="gw5" targetRef="end1">
      <extensionElements>
        <flowable:executionListener event="take" class="sv.gob.mh.siip.bpm.listeners.VersionSnapshotListener"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression">${decisionCierreSYMP == 'definitivo'}</conditionExpression>
    </sequenceFlow>

    <endEvent id="end1" name="Proyecto Cerrado"/>

  </process>

