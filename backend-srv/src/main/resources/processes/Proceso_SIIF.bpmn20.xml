      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="sf_revisionsymp_a_gw5" id="Edge_sf_revisionsymp_a_gw5">
        <omgdi:waypoint x="940" y="660"/>
        <omgdi:waypoint x="1000" y="660"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="sf19_observado_cierre" id="Edge_sf19">
