	<profiles>
		<profile>
			<id>sonar-host-desde-env</id>
			<activation>
				<property>
					<name>env.SONAR_HOST_URL</name>
				</property>
			</activation>
			<properties>
				<sonar.host.url>${env.SONAR_HOST_URL}</sonar.host.url>
			</properties>
		</profile>
		<!-- Perfil: Pruebas de integración (Karate) contra servicio desplegado -->
		<profile>
			<id>integration-tests</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<version>3.5.3</version>
						<configuration>
							<includes>
								<include>**/IntegrationTestRunner.java</include>
								<include>**/HealthRunner.java</include>
								<include>**/SecurityRunner.java</include>
							</includes>
							<excludes combine.self="override" />
							<systemPropertyVariables>
								<karate.env>${karate.env}</karate.env>
								<!-- karate-config.js exige base.url y oauth2.token.url en cualquier
                                     ambiente que no sea local. Surefire FORKEA el JVM, asi que
                                     un -D de la linea de comandos no llega a las pruebas: hay
                                     que reenviarlo aqui o Karate aborta con "-Dbase.url es
                                     obligatoria" antes de probar nada. -->
								<base.url>${base.url}</base.url>
								<oauth2.token.url>${oauth2.token.url}</oauth2.token.url>
								<oauth2.client.id>${oauth2.client.id}</oauth2.client.id>
								<oauth2.client.secret>${oauth2.client.secret}</oauth2.client.secret>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

