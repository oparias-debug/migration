{
  "name": "siip-front",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:api",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "cucumber-js",
    "generate:api": "npm run generate:api:administracion-cu-adm-02 && npm run generate:api:preinversion-cu-pre-01 && npm run generate:api:preinversion-cu-pre-01.5 && npm run generate:api:preinversion-cu-pre-02 && npm run generate:api:preinversion-cu-pre-03 && npm run generate:api:preinversion-cu-pre-3.5 && npm run generate:api:preinversion-cu-pre-04 && npm run generate:api:preinversion-cu-pre-05 && npm run generate:api:preinversion-cu-pre-06 && npm run generate:api:preinversion-cu-pre-07 && npm run generate:api:preinversion-cu-pre-08 && npm run generate:api:preinversion-cu-pre-09 && npm run generate:api:preinversion-cu-pre-11 && npm run generate:api:preinversion-cu-pre-17 && npm run generate:api:administracion-cu-adm-01 && npm run generate:api:preinversion-cu-pre-12 && npm run generate:api:administracion-cu-adm-04",
    "generate:api:administracion-cu-adm-02": "openapi-generator-cli generate -i openapi/administracion/catalogo/CU-ADM-02-catalogos.openapi.yaml -g typescript-axios -o src/api/generated/administracion-catalogos --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-01": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-01.openapi.yaml -g typescript-axios -o src/api/generated/preinversion --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-01.5": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-01.5.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-revision-cup --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-02": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-02.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-bandeja --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-03": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-03.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-captura --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-3.5": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-03.5.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-etapas --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-04": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-04.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-identificacion --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-05": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-05.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-alternativas --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "sonar": "npm run generate:api && npm run test:coverage && npx --yes @sonar/scan",
    "generate:api:administracion-cu-adm-01": "openapi-generator-cli generate -i openapi/administracion/catalogo/CU-ADM-01-administracion-de-catalogos.openapi.yaml -g typescript-axios -o src/api/generated/administracion-catalogos-admin --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-17": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-17.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-presupuesto --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-06": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-06.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-interesados --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-07": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-07.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-poblacion --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-08": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-08.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-area-influencia --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-09": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-09.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-mercado --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-11": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-11.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-descripcion-tecnica --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:administracion-cu-adm-04": "openapi-generator-cli generate -i openapi/administracion/calendario/CU-ADM-04-gestion-de-calendario.openapi.yaml -g typescript-axios -o src/api/generated/administracion-calendario --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "generate:api:preinversion-cu-pre-12": "openapi-generator-cli generate -i openapi/preinversion/CU-PRE-12.openapi.yaml -g typescript-axios -o src/api/generated/preinversion-localizacion --additional-properties=supportsES6=true,withInterfaces=true,useSingleRequestParameter=true",
    "gate": "node scripts/comprobar-quality-gate.mjs",
    "verificar": "npm run sonar && npm run gate"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "axios": "^1.7.9",
    "flatpickr": "^4.6.13",
    "i18next": "^24.2.1",
    "jwt-decode": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^6.28.1",
    "sweetalert2": "^11.15.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
