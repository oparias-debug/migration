# Copiá este archivo a ".env" (mismo folder) antes de correr "docker compose up".
# Los valores de abajo son de desarrollo/pruebas para un stack 100% local y aislado
# (nadie más se conecta a esta base ni a este Keycloak) - no son las credenciales reales
# del ambiente de SIIP. No hace falta cambiarlos para levantar el stack.

# --- Imagen a usar (ver instrucciones de "docker login" en README.md) ---
IMAGE_REGISTRY=ghcr.io/david-magnaperita
IMAGE_TAG=latest

# --- Base de datos ---
DB_USER=siip
DB_PASSWORD=siip-tester-local
DB_DATABASE=preinversiondb
DB_URL=jdbc:postgresql://postgres:5432/preinversiondb
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
DB_SCHEMA=public

# --- Keycloak ---
KEYCLOAK_REALM=siip-api
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_EXTERNAL_URL=http://localhost:8085
KEYCLOAK_CLIENT_ID=api-gateway
# Tiene que ser exactamente este valor: es el que ya viene horneado en el realm-export.json
# de la imagen de keycloak (keycloak/realm-export.json) - no es un secreto real, es config
# de desarrollo fija para este realm local.
KEYCLOAK_CLIENT_SECRET=dvUYyLd427TYWY5KKzGu4KCTj8s02A5x

# --- api-gateway / front ---
GATEWAY_INTERNAL_URL=http://api-gateway:8080
GATEWAY_URL=http://localhost:8080
