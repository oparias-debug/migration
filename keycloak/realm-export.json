{
  "realm": "siip-api",
  "enabled": true,
  "displayName": "SIIP API Realm",

  "roles": {
    "realm": [
      {
        "name": "ADMINISTRADOR",
        "description": "Administrador del Sistema (SIIP). Gestión de solicitudes de CUP y programación cuatrimestral de Preinversión (3 CU)."
      },
      {
        "name": "COORDINADOR_PRE",
        "description": "Coordinador de Preinversión (SIIP). Revisión/emisión de CUP, priorización, opinión técnica, banco de proyectos y programación/avance cuatrimestral de Preinversión (10 CU)."
      },
      {
        "name": "COORDINADOR_PROGRAMACION",
        "description": "Coordinador de Programación y Análisis (SIIP). Monitoreo de programación del PAIP/PAP y presupuesto de inversión (9 CU)."
      },
      {
        "name": "COORDINADOR_SYMP",
        "description": "Coordinador de Seguimiento y Monitoreo de Proyectos (SIIP). Presupuesto de inversión, priorización y programación de metas físicas (5 CU)."
      },
      {
        "name": "JEFE_DGI",
        "description": "Jefe DGI (SIIP). Priorización y programación/avance cuatrimestral financiero y de metas físicas de Preinversión (5 CU)."
      },
      {
        "name": "SUBJEFE_DGI",
        "description": "Subjefe DGI (SIIP). Priorización y programación/avance cuatrimestral financiero y de metas físicas de Preinversión (5 CU)."
      },
      {
        "name": "TECNICO_PRE",
        "description": "Técnico de Preinversión (SIIP). Registro y análisis del ciclo de proyectos en fase de Preinversión: área de influencia, mercado, técnica, ambiental, riesgo, legal, presupuesto, indicadores y elegibilidad (25 CU)."
      },
      {
        "name": "TECNICO_PROG",
        "description": "Técnico de Programación y Análisis (SIIP). Monitoreo de programación del PAIP/PAP y presupuesto de inversión (9 CU)."
      },
      {
        "name": "TECNICO_SYMP",
        "description": "Técnico de Seguimiento y Monitoreo de Proyectos (SIIP). Escenarios de programación, consolidado de techos, monitoreo mensual del PAIP y visitas de campo (11 CU)."
      },
      {
        "name": "TECNICO_LEGAL",
        "description": "Técnico de la Unidad de Asesoría Legal (SIIP). Registro, modificación y ficha de convenios (4 CU)."
      },
      {
        "name": "TECNICO_URP",
        "description": "Técnico de la Unidad Responsable de Proyecto (SIIP). Identificación, análisis y programación/avance financiero y físico del proyecto a lo largo de todo el ciclo (41 CU)."
      },
      {
        "name": "VIABILIZADOR",
        "description": "Viabilizador (SIIP). Evaluación de viabilidad, elegibilidad y opinión técnica de proyectos (4 CU)."
      },
      {
        "name": "ADMINISTRADOR_DE_CATALOGOS",
        "description": "Administrador de Catálogos (SIIP). Administra catálogos maestros y sus registros (CU-ADM-01). Actor aún no incorporado formalmente a catalogo-actores.md."
      },
      {
        "name": "ADMINISTRADOR_CALENDARIO",
        "description": "Administrador de Calendarios (SIIP). Administra los calendarios bajo su responsabilidad (CU-ADM-04, RN12)."
      },
      {
        "name": "TECNICO_SEG",
        "description": "[SUPUESTO] Técnico de Seguimiento (SIIP). Rol identificado en Anexo C sin casos de uso implementados aún; no incorporado formalmente a catalogo-actores.md."
      },
      {
        "name": "TECNICO_OPE",
        "description": "[SUPUESTO] Técnico Operativo (SIIP). Rol identificado en Anexo C sin casos de uso implementados aún; no incorporado formalmente a catalogo-actores.md."
      },
      {
        "name": "TECNICO_SIAF",
        "description": "[SUPUESTO] Técnico de interfaz con SIAF (SIIP). Rol identificado en Anexo C, relacionado con la integración a un sistema externo (ver SistemaExterno/CU-ITF-01); sin casos de uso implementados aún."
      },
      {
        "name": "INGENIERO_DINAFI",
        "description": "[SUPUESTO] Ingeniero DINAFI (SIIP). Rol identificado en Anexo C sin casos de uso implementados aún; no incorporado formalmente a catalogo-actores.md."
      }
    ]
  },

  "clients": [
    {
      "clientId": "swagger-ui",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:8080/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": ["+"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "api-gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "secret": "dvUYyLd427TYWY5KKzGu4KCTj8s02A5x",
      "publicClient": false,
      "redirectUris": [],
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "roles"
      ]
    }
  ],

  "clientScopes": [
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "role",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],

